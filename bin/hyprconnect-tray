#!/usr/bin/env python3
"""
HyprConnect Linux System Tray Applet
Provides a StatusNotifierItem / AppIndicator with live battery, connection state,
file sharing, SMS, ringing, clipboard syncing, and pairing QR code.
"""

import os
import sys
import json
import socket
import subprocess
import threading
import tempfile
import gi

gi.require_version('Gtk', '3.0')
try:
    gi.require_version('AyatanaAppIndicator3', '0.1')
    from gi.repository import AyatanaAppIndicator3 as appindicator
except Exception:
    gi.require_version('AppIndicator3', '0.1')
    from gi.repository import AppIndicator3 as appindicator

from gi.repository import Gtk, Gdk, GdkPixbuf, GLib

CSS_DATA = b"""
window, dialog {
    background-color: #181825;
    color: #CDD6F4;
}
entry, textview text {
    background-color: #1E1E2E;
    color: #CDD6F4;
    border: 1px solid #313244;
    border-radius: 8px;
    padding: 8px;
}
entry:focus, textview text:focus {
    border-color: #89DCEB;
}
button {
    background-color: #313244;
    color: #CDD6F4;
    border-radius: 8px;
    padding: 8px 16px;
    border: 1px solid #45475A;
}
button:hover {
    background-color: #45475A;
}
button.suggested-action {
    background-color: #89DCEB;
    color: #11111B;
    font-weight: bold;
    border: none;
}
button.suggested-action:hover {
    background-color: #74C7EC;
}
"""

def load_css():
    try:
        screen = Gdk.Screen.get_default()
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS_DATA)
        Gtk.StyleContext.add_provider_for_screen(
            screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )
    except Exception:
        pass

def get_sock_path():
    runtime_dir = os.environ.get('XDG_RUNTIME_DIR', '/tmp')
    return os.path.join(runtime_dir, 'hyprconnect.sock')

def ipc_call(req_dict, timeout=3.0):
    try:
        sock_path = get_sock_path()
        if not os.path.exists(sock_path):
            return None
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(timeout)
        s.connect(sock_path)
        s.sendall(json.dumps(req_dict).encode('utf-8') + b'\n')
        resp_data = b''
        while b'\n' not in resp_data:
            chunk = s.recv(4096)
            if not chunk:
                break
            resp_data += chunk
        s.close()
        line = resp_data.decode('utf-8', errors='ignore').strip()
        if line:
            return json.loads(line)
    except Exception:
        pass
    return None

def notify(summary, body="", icon=None):
    try:
        cmd = ["notify-send", "-a", "HyprConnect"]
        if icon:
            cmd.extend(["-i", icon])
        cmd.extend([summary, body])
        subprocess.Popen(cmd)
    except Exception:
        pass

SVG_ONLINE = """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 108 108" width="128" height="128">
  <path fill="#89DCEB" d="M 54,18 L 19.5,86 L 37.8,86 L 54,52 Z" />
  <path fill="#89DCEB" fill-opacity="0.80" d="M 54,18 L 54,52 L 70.2,86 L 88.5,86 Z" />
  <path fill="#89DCEB" fill-opacity="0.92" d="M 54,52 L 41,80 L 67,80 Z" />
</svg>"""

SVG_OFFLINE = """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 108 108" width="128" height="128">
  <path fill="#585B70" d="M 54,18 L 19.5,86 L 37.8,86 L 54,52 Z" />
  <path fill="#585B70" fill-opacity="0.80" d="M 54,18 L 54,52 L 70.2,86 L 88.5,86 Z" />
  <path fill="#585B70" fill-opacity="0.92" d="M 54,52 L 41,80 L 67,80 Z" />
</svg>"""

class HyprConnectTray:
    def __init__(self):
        self.icon_dir = self._locate_icon_dir()
        online_png = os.path.join(self.icon_dir, "hyprconnect.png")
        self.online_icon = online_png if os.path.exists(online_png) else os.path.join(self.icon_dir, "hyprconnect.svg")
        offline_png = os.path.join(self.icon_dir, "hyprconnect-offline.png")
        self.offline_icon = offline_png if os.path.exists(offline_png) else os.path.join(self.icon_dir, "hyprconnect-offline.svg")

        self.indicator = appindicator.Indicator.new(
            "hyprconnect",
            self.offline_icon,
            appindicator.IndicatorCategory.APPLICATION_STATUS
        )
        self.indicator.set_status(appindicator.IndicatorStatus.ACTIVE)
        self.indicator.set_title("HyprConnect")

        self.current_device = None
        self.is_connected = False

        self.build_menu()
        self.update_status()
        GLib.timeout_add_seconds(2, self.update_status)

    def _locate_icon_dir(self):
        candidates = [
            os.path.join(os.path.dirname(__file__), "..", "icons"),
            os.path.expanduser("~/.local/share/hyprconnect/icons"),
            os.path.expanduser("~/.local/share/icons/hicolor/128x128/apps"),
            "/tmp/hyprconnect-icons"
        ]
        for c in candidates:
            if os.path.exists(os.path.join(c, "hyprconnect.png")) or os.path.exists(os.path.join(c, "hyprconnect.svg")):
                return os.path.abspath(c)

        # Fallback: write embedded SVGs
        target_dir = os.path.expanduser("~/.local/share/hyprconnect/icons")
        try:
            os.makedirs(target_dir, exist_ok=True)
        except Exception:
            target_dir = "/tmp/hyprconnect-icons"
            os.makedirs(target_dir, exist_ok=True)

        try:
            with open(os.path.join(target_dir, "hyprconnect.svg"), "w") as f:
                f.write(SVG_ONLINE)
            with open(os.path.join(target_dir, "hyprconnect-offline.svg"), "w") as f:
                f.write(SVG_OFFLINE)
        except Exception:
            pass

        return target_dir

    def build_menu(self):
        self.menu = Gtk.Menu()

        # 1. Device Info Header
        self.item_device = Gtk.MenuItem(label="📱 Disconnected")
        self.item_device.set_sensitive(False)
        self.menu.append(self.item_device)

        self.item_battery = Gtk.MenuItem(label="🔋 Battery: N/A")
        self.item_battery.set_sensitive(False)
        self.menu.append(self.item_battery)

        self.item_status = Gtk.MenuItem(label="📶 Waiting for connection...")
        self.item_status.set_sensitive(False)
        self.menu.append(self.item_status)

        self.menu.append(Gtk.SeparatorMenuItem())

        # 2. Actions
        self.item_send = Gtk.MenuItem(label="📁 Send File to Phone...")
        self.item_send.connect("activate", self.on_send_file)
        self.menu.append(self.item_send)

        self.item_sms = Gtk.MenuItem(label="💬 Send SMS...")
        self.item_sms.connect("activate", self.on_send_sms)
        self.menu.append(self.item_sms)

        self.item_ring = Gtk.MenuItem(label="🔔 Ring Phone")
        self.item_ring.connect("activate", self.on_ring_phone)
        self.menu.append(self.item_ring)

        self.item_clip = Gtk.MenuItem(label="📋 Sync Clipboard to Phone")
        self.item_clip.connect("activate", self.on_sync_clip)
        self.menu.append(self.item_clip)

        self.menu.append(Gtk.SeparatorMenuItem())

        # 3. Pairing
        self.item_pair = Gtk.MenuItem(label="➕ Pair New Device (QR)...")
        self.item_pair.connect("activate", self.on_pair_new)
        self.menu.append(self.item_pair)

        self.menu.append(Gtk.SeparatorMenuItem())

        # 4. Quit
        item_quit = Gtk.MenuItem(label="🚪 Quit Tray")
        item_quit.connect("activate", lambda _: Gtk.main_quit())
        self.menu.append(item_quit)

        self.menu.show_all()
        self.indicator.set_menu(self.menu)

    def update_status(self):
        res = ipc_call({"cmd": "devices"})
        connected_dev = None
        if res and res.get("ok"):
            devices = res.get("devices", [])
            for d in devices:
                if d.get("connected"):
                    connected_dev = d
                    break

        if connected_dev:
            self.current_device = connected_dev
            self.is_connected = True
            name = connected_dev.get("name", "Phone")
            bat = connected_dev.get("battery")

            self.indicator.set_icon_full(self.online_icon, "HyprConnect - Connected")
            self.item_device.set_label(f"📱 {name} (Connected)")

            if bat and bat.get("pct") is not None:
                pct = bat.get("pct")
                chg = bat.get("charging", False)
                bat_icon = "⚡" if chg else "🔋"
                chg_str = " (Charging)" if chg else ""
                self.item_battery.set_label(f"{bat_icon} Battery: {pct}%{chg_str}")
                self.item_battery.set_visible(True)
                tooltip = f"HyprConnect: {name} ({pct}%)"
            else:
                self.item_battery.set_visible(False)
                tooltip = f"HyprConnect: {name}"

            self.item_status.set_label("📶 Status: Connected (Wi-Fi)")

            self.item_send.set_sensitive(True)
            self.item_sms.set_sensitive(True)
            self.item_ring.set_sensitive(True)
            self.item_clip.set_sensitive(True)

            self.indicator.set_title(tooltip)
        else:
            self.current_device = None
            self.is_connected = False
            self.indicator.set_icon_full(self.offline_icon, "HyprConnect - Offline")
            self.item_device.set_label("📱 No Phone Connected")
            self.item_battery.set_visible(False)
            self.item_status.set_label("📶 Status: Waiting for connection...")

            self.item_send.set_sensitive(False)
            self.item_sms.set_sensitive(False)
            self.item_ring.set_sensitive(False)
            self.item_clip.set_sensitive(False)

            self.indicator.set_title("HyprConnect - Offline")

        return True

    def on_send_file(self, _):
        dialog = Gtk.FileChooserDialog(
            title="HyprConnect — Send File to Phone",
            parent=None,
            action=Gtk.FileChooserAction.OPEN
        )
        dialog.add_buttons(
            Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL,
            "Send", Gtk.ResponseType.OK
        )
        dialog.set_select_multiple(True)
        response = dialog.run()
        filenames = dialog.get_filenames()
        dialog.destroy()

        if response == Gtk.ResponseType.OK and filenames:
            def worker():
                for fn in filenames:
                    base = os.path.basename(fn)
                    notify("Sending File", f"Sending {base} to phone...", self.online_icon)
                    res = ipc_call({"cmd": "send", "path": fn})
                    if res and res.get("ok"):
                        notify("File Sent", f"Successfully sent {base}", self.online_icon)
                    else:
                        err = res.get("error") if res else "Connection failed"
                        notify("Send Failed", f"Could not send {base}: {err}", self.offline_icon)
            threading.Thread(target=worker, daemon=True).start()

    def on_send_sms(self, _):
        win = Gtk.Window(title="HyprConnect — Send SMS")
        win.set_default_size(360, 240)
        win.set_position(Gtk.WindowPosition.CENTER)
        win.set_border_width(16)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        win.add(box)

        lbl = Gtk.Label(label="<b>Send SMS through Phone</b>")
        lbl.set_use_markup(True)
        lbl.set_xalign(0)
        box.pack_start(lbl, False, False, 0)

        entry_to = Gtk.Entry()
        entry_to.set_placeholder_text("Phone Number (e.g. +98912...)")
        box.pack_start(entry_to, False, False, 0)

        txt_body = Gtk.TextView()
        txt_body.set_wrap_mode(Gtk.WrapMode.WORD)
        txt_buf = txt_body.get_buffer()
        txt_buf.set_text("")
        box.pack_start(txt_body, True, True, 0)

        btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        box.pack_start(btn_box, False, False, 0)

        btn_cancel = Gtk.Button(label="Cancel")
        btn_cancel.connect("activate", lambda _: win.destroy())
        btn_cancel.connect("clicked", lambda _: win.destroy())
        btn_box.pack_end(btn_cancel, False, False, 0)

        btn_send = Gtk.Button(label="Send SMS")
        btn_send.get_style_context().add_class("suggested-action")
        def do_send(_):
            to = entry_to.get_text().strip()
            start, end = txt_buf.get_bounds()
            body = txt_buf.get_text(start, end, True).strip()
            win.destroy()
            if to and body:
                def worker():
                    res = ipc_call({"cmd": "sms", "to": to, "body": body})
                    if res and res.get("ok"):
                        notify("SMS Sent", f"Message sent to {to}", self.online_icon)
                    else:
                        notify("SMS Failed", "Could not send SMS", self.offline_icon)
                threading.Thread(target=worker, daemon=True).start()
        btn_send.connect("clicked", do_send)
        btn_box.pack_end(btn_send, False, False, 0)

        win.show_all()

    def on_ring_phone(self, _):
        def worker():
            res = ipc_call({"cmd": "ring"})
            if res and res.get("ok"):
                notify("Ringing Phone", "Sent ring command to phone", self.online_icon)
            else:
                notify("Ring Failed", "Could not ring phone", self.offline_icon)
        threading.Thread(target=worker, daemon=True).start()

    def on_sync_clip(self, _):
        def worker():
            res = ipc_call({"cmd": "clip"})
            if res and res.get("ok"):
                notify("Clipboard Synced", "Desktop clipboard sent to phone", self.online_icon)
            else:
                notify("Sync Failed", "Could not sync clipboard", self.offline_icon)
        threading.Thread(target=worker, daemon=True).start()

    def on_pair_new(self, _):
        res = ipc_call({"cmd": "pair"})
        if not res or not res.get("ok"):
            notify("Pairing Failed", "Could not initiate pairing with daemon", self.offline_icon)
            return

        uri = res.get("uri", "")

        win = Gtk.Window(title="HyprConnect — Pair New Device")
        win.set_default_size(340, 440)
        win.set_position(Gtk.WindowPosition.CENTER)
        win.set_border_width(20)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        win.add(box)

        lbl_title = Gtk.Label(label="<span size='large' weight='bold' color='#89DCEB'>Pair New Device</span>")
        lbl_title.set_use_markup(True)
        box.pack_start(lbl_title, False, False, 0)

        lbl_desc = Gtk.Label(label="Scan this QR code with the HyprConnect mobile app:")
        lbl_desc.set_line_wrap(True)
        box.pack_start(lbl_desc, False, False, 0)

        # Generate QR image using qrencode if available
        qr_file = tempfile.mktemp(suffix=".png")
        qr_image = None
        try:
            subprocess.run(["qrencode", "-o", qr_file, "-s", "6", uri], check=True, timeout=3)
            pixbuf = GdkPixbuf.Pixbuf.new_from_file(qr_file)
            qr_image = Gtk.Image.new_from_pixbuf(pixbuf)
        except Exception:
            qr_image = Gtk.Label(label=uri)
            qr_image.set_line_wrap(True)

        if os.path.exists(qr_file):
            try:
                os.remove(qr_file)
            except Exception:
                pass

        box.pack_start(qr_image, True, True, 0)

        # URI Entry
        entry_uri = Gtk.Entry()
        entry_uri.set_text(uri)
        entry_uri.set_editable(False)
        box.pack_start(entry_uri, False, False, 0)

        btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        box.pack_start(btn_box, False, False, 0)

        btn_copy = Gtk.Button(label="📋 Copy URL")
        def copy_url(_):
            clipboard = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
            clipboard.set_text(uri, -1)
            notify("HyprConnect", "Pairing URL copied to clipboard", self.online_icon)
        btn_copy.connect("clicked", copy_url)
        btn_box.pack_start(btn_copy, True, True, 0)

        btn_done = Gtk.Button(label="Done")
        btn_done.get_style_context().add_class("suggested-action")
        btn_done.connect("clicked", lambda _: win.destroy())
        btn_box.pack_start(btn_done, True, True, 0)

        win.show_all()

def main():
    load_css()
    _app = HyprConnectTray()
    Gtk.main()

if __name__ == "__main__":
    main()
